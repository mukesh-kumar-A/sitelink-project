# Copy this file to .env and replace all sample values before deployment.
SITE_DOMAIN=your-domain.example
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Required for first-run Admin setup when deployed through Docker Compose.
REQUIRE_SETUP_TOKEN=1
SETUP_TOKEN=replace-with-a-separate-one-time-random-token

# Public signup creates a pending Viewer in this existing workspace.
# Change the ID if the workspace uses a different tenant ID.
SIGNUP_TENANT_ID=tenant-default
PUBLIC_SIGNUP=1

HOST=0.0.0.0
PORT=8000
SESSION_HOURS=12
COOKIE_SECURE=auto

# Optional. When enabled, supervisor report text is sent to the configured
# structured-output model. The key stays server-side and is never sent to browsers.
TIME_AGENT_ENABLED=0
OPENAI_API_KEY=
TIME_AGENT_MODEL=
TIME_AGENT_API_URL=https://api.openai.com/v1/responses
TIME_AGENT_TIMEOUT_SECONDS=12

# Optional Ask SiteLink explanation provider. The deterministic answer is
# always available; this provider only adds a validated evidence-citing summary.
SITELINK_AI_ENABLED=0
SITELINK_AI_MODEL=
SITELINK_AI_API_URL=https://api.openai.com/v1/responses
SITELINK_AI_TIMEOUT_SECONDS=12
SITELINK_AI_RETRIES=1
